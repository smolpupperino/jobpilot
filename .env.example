# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit it, never paste it into chat.

# Random secret for signing login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JOBPILOT_SESSION_SECRET=

# Your time zone (used for the daily summary and "today").
JOBPILOT_TIMEZONE=America/Los_Angeles

# Leave true. Tailscale Serve gives you HTTPS. Set false ONLY if you are testing
# over plain http://127.0.0.1:8080 on the mini PC itself.
JOBPILOT_COOKIE_SECURE=true

# ---- Telegram (optional until you set it up; see docs/SETUP.md) ----
# Token from @BotFather.
JOBPILOT_TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Leave blank at first: message your bot and it
# will reply with your ID. Then put it here and restart.
JOBPILOT_TELEGRAM_OWNER_ID=

# Your dashboard URL from `tailscale serve status` (used for links in Telegram).
JOBPILOT_PUBLIC_BASE_URL=

# Passwordless dashboard login: your Tailscale login email. Requests through
# `tailscale serve` from this account are treated as the owner. Blank = password only.
# JOBPILOT_TAILSCALE_OWNER_LOGIN=you@example.com

# Browser automation (Phase 4)
# Password for watching/taking over the browser via noVNC (VNC uses 8 characters).
# JOBPILOT_VNC_PASSWORD=change-me
# Link sent to you when JobPilot needs you in the browser:
# JOBPILOT_BROWSER_VIEW_URL=https://<machine>.<tailnet>.ts.net:8443/vnc.html?autoconnect=1&resize=scale
